{
  "name": "automated-report",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:doppler": "doppler run -- npm run dev",
    "dev:locus": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-locus-dev.ps1",
    "notion:smoke": "node scripts/notion-smoke.mjs",
    "search-terms:sqlite:init": "node scripts/init-search-term-sqlite.mjs",
    "search-terms:sqlite:test": "node scripts/search-term-sqlite-smoke.mjs",
    "search-terms:lead-quality:test": "tsx scripts/search-term-lead-quality.test.mts",
    "search-terms:sqlite:inspect": "node scripts/inspect-search-term-sqlite.mjs",
    "search-terms:sqlite:approver-test": "tsx scripts/search-term-approver-sqlite.test.mts",
    "search-terms:scheduler": "node scripts/run-due-search-term-analyses.mjs",
    "search-terms:scheduler:doppler": "doppler run -- npm run search-terms:scheduler",
    "search-terms:settings:test": "tsx scripts/search-term-account-settings.test.mts",
    "search-terms:priority:test": "uv run --project lib/search-term-optimization/python --group ads --group ads-agent python scripts/search-term-priority.test.py",
    "optimization-scheduling:test": "tsx scripts/optimization-scheduling.test.mts",
    "search-terms:pm-reports:test": "tsx scripts/search-term-pm-reports.test.mts",
    "search-terms:pm-reports:seed": "tsx scripts/seed-search-term-pm-report-prototype.mts",
    "placements:sqlite:test": "tsx scripts/placement-optimization-sqlite.test.mts",
    "team-lead:sqlite:test": "tsx scripts/team-lead-monitoring-sqlite.test.mts",
    "dev:m04-stage2": "doppler run -- npm run dev",
    "test:m04-stage2": "tsx scripts/m04-stage2.test.mts",
    "send:drive-pdf-emails": "node --import jiti/register scripts/send-drive-pdf-report-emails.mjs",
    "monthly:pdf:benchmark": "tsx scripts/monthly-report-pdf-benchmark.ts",
    "monthly-report:test:notion": "tsx scripts/monthly-report-pre-scheduler-test.ts notion",
    "monthly-report:test:pdf": "tsx scripts/monthly-report-pre-scheduler-test.ts pdf",
    "monthly-report:test:email": "tsx scripts/monthly-report-pre-scheduler-test.ts email",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "build:doppler": "doppler run -- npm run build",
    "start": "next start",
    "lint": "eslint",
    "test:meta-import": "tsx --test lib/meta-import/meta-import.test.ts",
    "test:tiktok": "tsx --test tests/tiktok/*.test.ts lib/reporting/tiktok-contract.test.ts lib/reporting/notion-account-search.test.ts src/lib/cron/monthly-report-date.test.ts",
    "tiktok:ads": "tsx .agents/skills/tiktok-ads-doppler/scripts/tiktok_ads.ts",
    "tiktok:ads:local": "node --env-file=.env.local --import tsx .agents/skills/tiktok-ads-doppler/scripts/tiktok_ads.ts",
    "tiktok:secrets:sync-local": "tsx scripts/sync-tiktok-secrets-local.ts",
    "test:m01": "tsx --test lib/traffic-quality/*.test.ts lib/ads-management/google.test.ts lib/ads-management/service.test.ts",
    "vercel:env:sync": "node scripts/sync-vercel-env.mjs",
    "vercel:deploy:preview": "vercel deploy",
    "vercel:deploy:prod": "vercel deploy --prod",
    "cf:monthly:dev": "cd cloudflare/monthly-report-cron && doppler run -- npx wrangler dev --test-scheduled",
    "cf:monthly:migrate": "cd cloudflare/monthly-report-cron && doppler run -- npx wrangler d1 migrations apply automation-report-jobs --remote",
    "cf:monthly:deploy": "cd cloudflare/monthly-report-cron && doppler run -- npx wrangler deploy",
    "cf:advanced-cache:migrate": "cd cloudflare/advanced-report-cache && doppler run -- npx wrangler d1 migrations apply automation-advanced-report-cache --remote",
    "cf:advanced-cache:deploy": "cd cloudflare/advanced-report-cache && doppler run -- npx wrangler deploy",
    "cf:meta-import:migrate": "cd cloudflare/meta-csv-import && doppler run -- npx wrangler d1 migrations apply automation-meta-csv-import --remote",
    "cf:meta-import:deploy": "cd cloudflare/meta-csv-import && doppler run -- npx wrangler deploy",
    "cf:billing:dev": "cd cloudflare/billing-operations-api && doppler run -- npx wrangler dev --remote --port 8788",
    "cf:billing:deploy": "cd cloudflare/billing-operations-api && doppler run -- npx wrangler deploy",
    "cf:optimization:dev": "cd cloudflare/search-term-optimization-scheduler && doppler run -- npx wrangler dev --test-scheduled",
    "cf:optimization:deploy": "cd cloudflare/search-term-optimization-scheduler && doppler run -- npx wrangler deploy",
    "cf:placements:dev": "cd cloudflare/placement-analysis && doppler run -- npx wrangler dev",
    "cf:placements:types": "cd cloudflare/placement-analysis && npx wrangler types",
    "cf:placements:deploy": "cd cloudflare/placement-analysis && doppler run -- npx wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@notionhq/client": "^5.20.0",
    "@sentry/nextjs": "^10.70.0",
    "@sparticuz/chromium": "^138.0.2",
    "@stepperize/react": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.8",
    "jspdf": "^4.2.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.1",
    "playwright-core": "^1.59.1",
    "posthog-js": "^1.417.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "resend": "^6.12.2",
    "shadcn": "^3.8.5",
    "sharp": "^0.35.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
