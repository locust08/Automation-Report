{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digitalbee-m03-pause-api",
  "main": "src/index.ts",
  "account_id": "e7c515dde995479daacd82ad79dfc3e8",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "vars": { "M03_WORKER_ENABLED": "false", "M03_PAUSE_MCP_ENABLED": "false", "ERROR_MONITORING_ENABLED": "false", "POSTHOG_HOST": "https://us.i.posthog.com", "POSTHOG_ENVIRONMENT": "production", "POSTHOG_RELEASE": "" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": { "bindings": [{ "name": "ERROR_MONITOR", "class_name": "ErrorMonitor", "script_name": "digitalbee-mcp" }] },
  "observability": { "enabled": true },
  "services": []
}
