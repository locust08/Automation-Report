\set ON_ERROR_STOP on
\set VERBOSITY verbose

select pg_catalog.set_config('application_name', :'app_session', false);

begin;
set local statement_timeout = '20s';
set local lock_timeout = '15s';
select pg_catalog.set_config('m04.approval_fixture', :'fixture', true);
select pg_catalog.set_config('m04.approval_case', :'case_name', true);
select pg_catalog.set_config('m04.approval_role', :'session_role', true);
select pg_catalog.set_config('m04.approval_key', :'request_key', true);
select pg_catalog.set_config('m04.approval_actor', :'actor_id', true);
set role service_role;

do $invoke_approval$
declare
  v_build public.ads_campaign_builds%rowtype;
begin
  begin
    select * into strict v_build
    from public.ads_approve_campaign_plan_revision(
      (select id from public.ads_campaign_plans
       where created_by_name = pg_catalog.current_setting('m04.approval_fixture')),
      (select active_revision_id from public.ads_campaign_plans
       where created_by_name = pg_catalog.current_setting('m04.approval_fixture')),
      repeat('b', 64), 7, clock_timestamp() + interval '2 hours',
      pg_catalog.current_setting('m04.approval_key'), 'parallel initial approval',
      pg_catalog.current_setting('m04.approval_actor')::uuid,
      '203.0.113.48',
      'm04-approval-parallel/' || pg_catalog.current_setting('m04.approval_role')
    );
    insert into public.m04_approval_parallel_results (
      case_name, session_role, sqlstate, build_id
    ) values (
      pg_catalog.current_setting('m04.approval_case'),
      pg_catalog.current_setting('m04.approval_role'), '00000', v_build.id
    );
  exception when others then
    insert into public.m04_approval_parallel_results (
      case_name, session_role, sqlstate, error_message
    ) values (
      pg_catalog.current_setting('m04.approval_case'),
      pg_catalog.current_setting('m04.approval_role'), sqlstate, sqlerrm
    );
  end;
end;
$invoke_approval$;

reset role;
commit;

select result.sqlstate as result_sqlstate,
       coalesce(result.build_id::text, 'none') as result_id,
       result.sqlstate = '00000' as result_ok
from public.m04_approval_parallel_results as result
where result.case_name = :'case_name' and result.session_role = :'session_role'
\gset
\echo M04_APPROVAL_PARALLEL_RESULT case=:case_name role=:session_role sqlstate=:result_sqlstate result_id=:result_id
\if :result_ok
\else
select pg_catalog.set_config('m04.recorded_child_sqlstate', :'result_sqlstate', false);
do $raise_recorded_child_error$
begin
  raise exception 'M04_RECORDED_APPROVAL_CHILD_ERROR'
    using errcode = pg_catalog.current_setting('m04.recorded_child_sqlstate');
end;
$raise_recorded_child_error$;
\endif
