\set ON_ERROR_STOP on
\set VERBOSITY verbose

select pg_catalog.set_config('application_name', :'app_invoking', false);

begin;
set local statement_timeout = '25s';
set local lock_timeout = '20s';
set role service_role;

\if :is_claim
select (public.ads_acquire_campaign_gate_claim(
  (select build.id
   from public.ads_campaign_builds as build
   join public.ads_campaign_plans as plan on plan.id = build.plan_id
   where plan.created_by_name = :'case_name'),
  1::smallint,
  'create',
  :'request_key',
  (select build.revision_id
   from public.ads_campaign_builds as build
   join public.ads_campaign_plans as plan on plan.id = build.plan_id
   where plan.created_by_name = :'case_name'),
  repeat('c', 64),
  300,
  '{"resources":[{"logical_resource_key":"campaign","resource_type":"campaign"}]}'::jsonb,
  '00000000-0000-0000-0000-000000000461',
  '203.0.113.46',
  'm04-state-race/' || :'case_name' || '/' || :'session_role'
)).id as result_id \gset
\elif :is_transition
select (public.ads_transition_campaign_plan(
  (select id from public.ads_campaign_plans where created_by_name = :'case_name'),
  :expected_plan_lock,
  :'expected_from_status',
  :'to_status',
  'deterministic state-race transition',
  '00000000-0000-0000-0000-000000000461',
  '203.0.113.46',
  'm04-state-race/' || :'case_name' || '/' || :'session_role'
)).id as result_id \gset
\elif :is_approval
select (public.ads_approve_campaign_plan_revision(
  (select id from public.ads_campaign_plans where created_by_name = :'case_name'),
  (select active_revision_id from public.ads_campaign_plans where created_by_name = :'case_name'),
  repeat('c', 64),
  :expected_plan_lock,
  clock_timestamp() + pg_catalog.make_interval(mins => :expiry_minutes),
  :'request_key',
  'deterministic state-race approval',
  '00000000-0000-0000-0000-000000000461',
  '203.0.113.46',
  'm04-state-race/' || :'case_name' || '/' || :'session_role'
)).id as result_id \gset
\elif :is_renewal
select (public.ads_approve_campaign_plan_revision(
  (select id from public.ads_campaign_plans where created_by_name = :'case_name'),
  (select active_revision_id from public.ads_campaign_plans where created_by_name = :'case_name'),
  repeat('c', 64),
  :expected_plan_lock,
  clock_timestamp() + pg_catalog.make_interval(mins => :expiry_minutes),
  :'request_key',
  'deterministic state-race renewal',
  '00000000-0000-0000-0000-000000000461',
  '203.0.113.46',
  'm04-state-race/' || :'case_name' || '/' || :'session_role'
)).id as result_id \gset
\else
\quit 3
\endif

reset role;

\if :hold_open
select pg_catalog.set_config('m04.state_case', :'case_name', true);
select pg_catalog.set_config('application_name', :'app_done', false);
do $hold_winner$
declare
  wait_deadline timestamptz := clock_timestamp() + interval '20 seconds';
begin
  loop
    exit when exists (
      select 1 from public.m04_state_race_release
      where case_name = pg_catalog.current_setting('m04.state_case') and released
    );
    if clock_timestamp() >= wait_deadline then
      raise exception 'State race winner release timed out'
        using errcode = '57014';
    end if;
    perform pg_catalog.pg_sleep(0.02);
  end loop;
end;
$hold_winner$;
\endif

commit;
\echo M04_STATE_RACE_SUCCESS case=:case_name role=:session_role result_id=:result_id
