META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_MONTHLY_REPORT=Locus-T <no-reply@locus-t.com.my>
# Optional sender for the daily Google Ads change digest. Falls back to RESEND_FROM_MONTHLY_REPORT.
ADS_CHANGE_DIGEST_FROM=LOCUS-T Ads Changes <reports@locus-t.com.my>
# Fallback for PIC select names that the Notion integration cannot see in /users.
# Example: {"Staff display name":"staff@locus-t.com.my"}
ADS_CHANGE_PIC_EMAIL_MAP={}
# Option A (direct bearer token):
GOOGLE_ADS_ACCESS_TOKEN=
# Option B (recommended for long-lived setup; access token is refreshed automatically):
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional; defaults to v22. Accepts `v22` or `22` format.
GOOGLE_ADS_API_VERSION=v22
# Supported aliases for Doppler setups already using OAuth naming:
# GOOGLE_OAUTH_ACCESS_TOKEN=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Notion lookup for DB | Ad Accounts (used to confirm the manager/MCC from `Access Path`)
NOTION_TOKEN=
# Raw Notion database ID, not the browser URL. If a full Notion URL is pasted,
# the app and smoke script will safely extract the database ID from it.
NOTION_DATABASE_ID=
NOTION_AD_ACCOUNTS_DATABASE_ID=
NOTION_MONTHLY_REPORT_LOGS_DATABASE_ID=
MONTHLY_REPORT_TEST_MODE=false
MONTHLY_REPORT_TEST_RECIPIENT=ava@locus-t.com.my
# Fixed Google Ads manager account fallback: 366-613-7525
GOOGLE_ADS_LOGIN_CUSTOMER_ID=366-613-7525
# Enables live publishing for Google Ads accounts accessible to the configured credentials.
GOOGLE_ADS_MANAGEMENT_WRITES_ENABLED=true
REPORT_COMPANY_NAME=Company Name
# Optional map by account ID (JSON or comma-separated `id:name` pairs).
# Example JSON:
# REPORT_COMPANY_NAME_MAP={"6972528848":"Soka International School"}
# REPORT_COMPANY_NAME_MAP={"283341217383189":"Your Registered Company Name"}
REPORT_COMPANY_NAME_MAP=
# Advanced Report automation rollback switch. false disables only scheduled/queue automation;
# manual /advanced preview and browser PDF download remain available.
ADVANCED_REPORT_ENABLED=true
# Advanced Report AI and market-data integrations.
OPENAI_API_KEY=
OPENAI_MEDIA_PLAN_MODEL=
OPENAI_MEDIA_PLAN_PROMPT_ID=pmpt_6a2a1ad15e148190af2a58292b6e6186085ff75e3c6e2cf6
ADVANCED_REPORT_OPENAI_MODEL=gpt-5.5
ADVANCED_REPORT_CREATIVE_OPENAI_MODEL=gpt-4.1-mini
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional for Advanced Report Google video creative analysis.
OPENROUTER_API_KEY=
ADVANCED_REPORT_VIDEO_OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional persistent cache for /api/reporting overall payloads.
# These can point at the Cloudflare report-cache Worker after running its migrations/deploy.
OVERALL_REPORT_CACHE_WORKER_URL=
OVERALL_REPORT_CACHE_SECRET=
# Optional; defaults to 21600 seconds (6 hours). Set to 0 or a negative value to disable.
OVERALL_REPORT_CACHE_TTL_SECONDS=0
# Optional process-local cache shared by Monthly Performance summary and campaign stages.
# Defaults to 120000 ms (2 minutes) and 100 account/date combinations.
REPORTING_OVERALL_PERFORMANCE_CACHE_TTL_MS=120000
REPORTING_OVERALL_PERFORMANCE_CACHE_MAX_ENTRIES=100
# Optional; stages slower than this are logged and surfaced as report diagnostics warnings.
REPORTING_SLOW_STAGE_WARNING_MS=10000
# Meta CSV import.
META_IMPORT_DEFAULT_ACCOUNT_ID=340568485376201
# URL and matching Worker secret for cloudflare/meta-csv-import.
META_IMPORT_WORKER_URL=
META_IMPORT_WORKER_SECRET=
# Optional process-local storage for `next start` smoke tests only; never set this in production.
META_IMPORT_ALLOW_EPHEMERAL_LOCAL=false
# Universal Billing Operations dashboard. The companion API reads the existing
# daily billing D1 snapshots; WORKER_API_TOKEN is shared server-to-server only.
BILLING_OPERATIONS_API_BASE_URL=
WORKER_API_TOKEN=
SUPABASE_ADS_REPORTING_AUTH_URL=
SUPABASE_SEARCH_TERM_RECOMMENDATIONS_URL=https://gsmxeosdjsbujhiwhbzk.supabase.co/rest/v1/ad_automation_search_term_recommendations
SUPABASE_SEARCH_TERM_REVIEWS_URL=https://gsmxeosdjsbujhiwhbzk.supabase.co/rest/v1/ad_automation_search_term_reviews
SEARCH_TERM_STORAGE_BACKEND=supabase
SEARCH_TERM_SQLITE_PATH=./data/search-term-optimization.sqlite
SUPABASE_SECRET_KEY=
ADS_REPORTING_JWT_SECRET=
# Supported aliases used by the shared Doppler project:
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET=
JWT_SECRET=
